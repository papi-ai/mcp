{
    "name": "papi-ai/mcp",
    "description": "Model Context Protocol client for PapiAI: hands an MCP server's tools to the Agent",
    "type": "library",
    "license": "MIT",
    "keywords": ["mcp", "model-context-protocol", "ai", "agent", "tools", "papi"],
    "authors": [
        {
            "name": "Marcello Duarte",
            "email": "marcello.duarte@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "papi-ai/papi-core": "^0.15.6",
        "mcp/sdk": "^0.10"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "vimeo/psalm": "^6.0",
        "symfony/http-client": "^6.4|^7.0|^8.0",
        "nyholm/psr7": "^1.8"
    },
    "suggest": {
        "symfony/http-client": "A PSR-18 client for HttpTransport, the remote server transport",
        "nyholm/psr7": "PSR-17 factories for HttpTransport"
    },
    "autoload": {
        "psr-4": {
            "PapiAI\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PapiAI\\Mcp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "XDEBUG_MODE=off php -d pcov.enabled=1 vendor/bin/pest --coverage --min=75",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "analyse": "psalm",
        "ci": [
            "@lint",
            "@analyse",
            "@test:coverage"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
